{
  "name": "wordstorms",
  "version": "0.1.1",
  "description": "Word storms: coordinated word clouds for comparing documents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quimcastella/wordstorms.git"
  },
  "homepage": "https://wordstorms.org",
  "keywords": [
    "word cloud",
    "word storm",
    "text visualization",
    "cli"
  ],
  "type": "module",
  "bin": {
    "wordstorms": "dist-cli/wordstorms.js"
  },
  "files": [
    "dist-cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "storm": "node scripts/storm.ts",
    "build:cli": "vite build -c vite.cli.config.ts",
    "prepack": "npm run build:cli",
    "render-examples": "node scripts/render-examples.ts",
    "build-corpora": "node scripts/build-corpora.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vite": "8.2.6",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@napi-rs/canvas": "1.1.0",
    "fflate": "^0.8.3"
  }
}
