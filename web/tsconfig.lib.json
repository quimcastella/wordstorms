{
  // Emits the library (src/index.ts, src/node.ts and what they import) as
  // JavaScript plus type declarations in dist-lib/, for the npm package.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist-lib",
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/index.ts", "src/node.ts"]
}
